[Unattend]
Signature = "$ClawOS$"

; Set UnattendSetupEnabled to yes in order to immediately start the ClawOS installer.
; yes - unattend setup enabled
; no - unattend setup disabled
UnattendSetupEnabled = no

; Set this option to automatically specify language in the language setup.
; See hivesys.inf for available languages.
LocaleID = 409

; Enable this section to apply a different default shell theme.
[Shell]
DefaultThemesOff = no
CustomDefaultThemeFile = "%WINDIR%\Resources\Themes\Mizu\mizu.msstyles"
